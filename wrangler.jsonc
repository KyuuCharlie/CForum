{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cforum",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-27",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"observability": { "enabled": true },
	"send_email": [{ "name": "EMAIL", "remote": true }],
	"d1_databases": [{
		"binding": "cforum_db",
		"database_name": "cforum-db",
		"database_id": "85b39523-e9f2-44a8-a80f-5b52608f4d90",
		"remote": true,
		"migrations_dir": "migrations"
	}],
	"workers_dev": true,
	"env": {
		"production": { "vars": { "WORKER_URL": "https://cforum.charliepointking.workers.dev", "BASE_URL": "https://sjjy.cc.cd" } },
		"development": { "vars": { "WORKER_URL": "http://localhost:8787" } }
	}
}
